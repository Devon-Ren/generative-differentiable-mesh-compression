<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="pipeline" id="p1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="A&amp;nbsp;&amp;nbsp;Budgeted growth &amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#52514e&quot;&gt;iterations 0 to 10k, every 500&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f4;strokeColor=#c9c8c2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="600" height="520" as="geometry" /></mxCell><mxCell id="3" value="draw: semi-transparent, unconnected triangles; one being split into 4, one left alone, one faint triangle removed" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a8983;fontColor=#52514e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="34" y="76" width="170" height="110" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;1&amp;nbsp; Error of triangle t&lt;/b&gt;&lt;br&gt;e&lt;sub&gt;t&lt;/sub&gt; = mean over training views of &amp;Sigma;&lt;sub&gt;p &amp;isin; P(t)&lt;/sub&gt; | I(p) &amp;minus; I&lt;sub&gt;gt&lt;/sub&gt;(p) |&lt;br&gt;&lt;i&gt;P(t)&lt;/i&gt;: pixels where t is the front triangle; &lt;i&gt;I, I&lt;sub&gt;gt&lt;/sub&gt;&lt;/i&gt;: rendered and real image" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="216" y="76" width="390" height="96" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;2&amp;nbsp; Size model, from block M (from 4k, every 1k)&lt;/b&gt;&lt;br&gt;R(V) = b&lt;sub&gt;v&lt;/sub&gt;&amp;middot;V + b&lt;sub&gt;f&lt;/sub&gt;&amp;middot;&amp;phi;&amp;middot;V + R&lt;sub&gt;0&lt;/sub&gt;&lt;br&gt;&lt;i&gt;V&lt;/i&gt;: vertices; &lt;i&gt;b&lt;sub&gt;v&lt;/sub&gt;&lt;/i&gt;: bytes per vertex and &lt;i&gt;R&lt;sub&gt;0&lt;/sub&gt;&lt;/i&gt;: fixed bytes, both measured on the soup; &lt;i&gt;b&lt;sub&gt;f&lt;/sub&gt;&lt;/i&gt;: bytes per face and &lt;i&gt;&amp;phi;&lt;/i&gt;: faces per vertex, fixed priors (the soup has no final connectivity)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="200" width="572" height="96" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;3&amp;nbsp; How many to split&lt;/b&gt;&lt;br&gt;V* = (1.35&amp;middot;T &amp;minus; R&lt;sub&gt;0&lt;/sub&gt;) / (b&lt;sub&gt;v&lt;/sub&gt; + &amp;phi;&amp;middot;b&lt;sub&gt;f&lt;/sub&gt;)&lt;br&gt;n = V&amp;middot;[ (V*/V)&lt;sup&gt;1/k&lt;/sup&gt; &amp;minus; 1 ] / (3&amp;sigma;)&lt;br&gt;&lt;i&gt;T&lt;/i&gt;: target file size; &lt;i&gt;k&lt;/i&gt;: growth rounds left; &lt;i&gt;&amp;sigma;&lt;/i&gt;: share of new vertices that survive MeshSplatting&amp;rsquo;s next clean-up (measured); 3: a split adds up to 3 vertices" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="310" width="572" height="112" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;4&amp;nbsp; Which to split&lt;/b&gt;&lt;br&gt;the n triangles with the largest e&lt;sub&gt;t&lt;/sub&gt; (not smaller than MeshSplatting&amp;rsquo;s size limits); all others stay as they are" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="436" width="330" height="76" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;MeshSplatting, unchanged&lt;/b&gt;&lt;br&gt;removes faint or oversized triangles every 500 iterations; picks triangles by sampling &amp;prop; importance&lt;sub&gt;t&lt;/sub&gt; = largest blending weight (replaced by step 4)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9e8e3;strokeColor=#8a8983;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="376" y="436" width="230" height="110" as="geometry" /></mxCell><mxCell id="9" value="no collapse in this phase: the soup has no shared edges" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="34" y="522" width="330" height="30" as="geometry" /></mxCell><mxCell id="10" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="B&amp;nbsp;&amp;nbsp;Connect" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e9e8e3;strokeColor=#c9c8c2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="170" height="520" as="geometry" /></mxCell><mxCell id="14" value="draw: the same triangles as one connected mesh" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a8983;fontColor=#52514e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="654" y="76" width="142" height="110" as="geometry" /></mxCell><mxCell id="15" value="restricted Delaunay triangulation at 11k (MeshSplatting, unchanged): from now on triangles share vertices and edges" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="654" y="200" width="142" height="150" as="geometry" /></mxCell><mxCell id="16" value="C&amp;nbsp;&amp;nbsp;Rate-locked refinement &amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#52514e&quot;&gt;12.5k to 29.5k, every 500 iterations, 35 rounds; nothing is grown&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f4;strokeColor=#c9c8c2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="40" width="640" height="520" as="geometry" /></mxCell><mxCell id="17" value="&lt;b&gt;1&amp;nbsp; Excess&lt;/b&gt;&lt;br&gt;E = R &amp;minus; T&lt;br&gt;&lt;i&gt;R&lt;/i&gt;: bytes of the whole file, measured by block M; if E &amp;le; 0 nothing is removed this round" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="76" width="300" height="96" as="geometry" /></mxCell><mxCell id="18" value="draw: an edge (u,v) between two triangles collapsing to one vertex, before and after" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a8983;fontColor=#52514e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1156" y="76" width="300" height="96" as="geometry" /></mxCell><mxCell id="19" value="&lt;b&gt;2&amp;nbsp; Cost of collapsing edge (u,v)&lt;/b&gt;&lt;br&gt;c&lt;sub&gt;uv&lt;/sub&gt; = &amp;Sigma;&lt;sub&gt;f touching u or v&lt;/sub&gt; e&lt;sub&gt;f&lt;/sub&gt; &amp;nbsp;/&amp;nbsp; &amp;Delta;R&lt;sub&gt;uv&lt;/sub&gt;&lt;br&gt;&amp;Delta;R&lt;sub&gt;uv&lt;/sub&gt; = b&lt;sub&gt;v&lt;/sub&gt;&amp;middot;[u and v are both in the file] + b&lt;sub&gt;f&lt;/sub&gt;&amp;middot;(faces on the edge that are in the file)&lt;br&gt;&lt;i&gt;e&lt;sub&gt;f&lt;/sub&gt;&lt;/i&gt;: error of face f as in A1; &amp;ldquo;in the file&amp;rdquo;: kept by block M" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="186" width="612" height="112" as="geometry" /></mxCell><mxCell id="20" value="&lt;b&gt;3&amp;nbsp; Which edges&lt;/b&gt;&lt;br&gt;take edges in order of increasing c&lt;sub&gt;uv&lt;/sub&gt;, skipping an edge if it shares a vertex with one already taken or if collapsing it flips a face normal, until &amp;Sigma; &amp;Delta;R&lt;sub&gt;uv&lt;/sub&gt; &amp;ge; E" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="312" width="612" height="80" as="geometry" /></mxCell><mxCell id="21" value="&lt;b&gt;4&amp;nbsp; Collapse and continue&lt;/b&gt;&lt;br&gt;u and v merge at their midpoint, colours averaged; then 500 training iterations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="406" width="400" height="66" as="geometry" /></mxCell><mxCell id="22" value="the mesh stays at the target size while it trains" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="844" y="486" width="400" height="30" as="geometry" /></mxCell><mxCell id="23" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="17" target="19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="19" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="20" target="21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" value="next round" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="21" target="17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="27" value="M&amp;nbsp;&amp;nbsp;Measure: how large would the file be if training stopped now? &amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#52514e&quot;&gt;used by A2 and C1&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f4;strokeColor=#2a78d6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1450" height="150" as="geometry" /></mxCell><mxCell id="28" value="&lt;b&gt;a&lt;/b&gt;&amp;nbsp; copy the mesh (training is not touched)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="616" width="200" height="60" as="geometry" /></mxCell><mxCell id="29" value="&lt;b&gt;b&lt;/b&gt;&amp;nbsp; render the copy at its final opacity from every training view; w&lt;sub&gt;f&lt;/sub&gt; = largest blending weight of face f" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="264" y="616" width="320" height="60" as="geometry" /></mxCell><mxCell id="30" value="&lt;b&gt;c&lt;/b&gt;&amp;nbsp; keep faces with w&lt;sub&gt;f&lt;/sub&gt; &amp;gt; 0.5, drop unused vertices (MeshSplatting&amp;rsquo;s final clean-up)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="614" y="616" width="300" height="60" as="geometry" /></mxCell><mxCell id="31" value="&lt;b&gt;d&lt;/b&gt;&amp;nbsp; run the real encoder (the one in D) on what is kept" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="944" y="616" width="260" height="60" as="geometry" /></mxCell><mxCell id="32" value="&lt;b&gt;R&lt;/b&gt; = file size in bytes;&lt;br&gt;also b&lt;sub&gt;v&lt;/sub&gt;, b&lt;sub&gt;f&lt;/sub&gt;, R&lt;sub&gt;0&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1234" y="616" width="220" height="60" as="geometry" /></mxCell><mxCell id="33" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="28" target="29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="34" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="29" target="30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="35" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="30" target="31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="36" value="" style="endArrow=block;html=1;strokeColor=#2a78d6;strokeWidth=1.5;" edge="1" parent="1" source="31" target="32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="37" value="in A the faces are not yet connected, so only b&lt;sub&gt;v&lt;/sub&gt; and R&lt;sub&gt;0&lt;/sub&gt; are taken from the measurement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="34" y="686" width="700" height="30" as="geometry" /></mxCell><mxCell id="38" value="D&amp;nbsp;&amp;nbsp;Encode &amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#52514e&quot;&gt;after training&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f4;strokeColor=#c9c8c2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1490" y="40" width="270" height="690" as="geometry" /></mxCell><mxCell id="39" value="&lt;b&gt;Shared colour codebook&lt;/b&gt;&lt;br&gt;main: 4,096 entries&lt;br&gt;residual: 256 entries&lt;br&gt;each vertex stores a base colour and two indices" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="76" width="242" height="100" as="geometry" /></mxCell><mxCell id="40" value="&lt;b&gt;Encoder&lt;/b&gt; (one lossless coder per stream; share of the file, garden 10 MB)&lt;br&gt;connectivity 39%&lt;br&gt;positions 21%&lt;br&gt;colour indices 19%&lt;br&gt;base colour 15%&lt;br&gt;codebooks 7%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="200" width="242" height="150" as="geometry" /></mxCell><mxCell id="41" value="one file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b0b0b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1574" y="380" width="100" height="40" as="geometry" /></mxCell><mxCell id="42" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="39" target="40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="43" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="40" target="41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="44" value="draw the encoder as a trapezoid with four bands whose widths follow the shares" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a8983;fontColor=#52514e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1504" y="440" width="242" height="60" as="geometry" /></mxCell><mxCell id="45" value="E&amp;nbsp;&amp;nbsp;Decode" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f7f4;strokeColor=#c9c8c2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1780" y="40" width="130" height="690" as="geometry" /></mxCell><mxCell id="46" value="&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;needs only the file; CPU" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="200" width="110" height="70" as="geometry" /></mxCell><mxCell id="47" value="draw: opaque mesh" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8a8983;fontColor=#52514e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1790" y="300" width="110" height="80" as="geometry" /></mxCell><mxCell id="48" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="41" target="46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="49" value="training iterations: &amp;nbsp; 0 &amp;mdash; A &amp;mdash; 10k &amp;nbsp;|&amp;nbsp; 11k connect &amp;nbsp;|&amp;nbsp; 12.5k &amp;mdash; C &amp;mdash; 29.5k &amp;nbsp;|&amp;nbsp; 30k end. &amp;nbsp; Opacity of the triangles rises from semi-transparent (5k) to fully opaque (24k)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="20" y="745" width="1450" height="30" as="geometry" /></mxCell><mxCell id="50" value="&lt;span style=&quot;background-color:#e6f0fc&quot;&gt;&amp;nbsp;ours&amp;nbsp;&lt;/span&gt; &amp;nbsp; &lt;span style=&quot;background-color:#e9e8e3&quot;&gt;&amp;nbsp;as in MeshSplatting&amp;nbsp;&lt;/span&gt; &amp;nbsp; dashed boxes: illustrations to draw" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>